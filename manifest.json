{
  "manifest_version": 3,
  "name": "Custom Quicktext Community Scripts",
  "short_name": "Custom Community Scripts",
  "description": "A set of Quicktext scripts maintained by the community and customized by carloshr",
  "version": "1.4",
  "author": "Quicktext Community",
  "browser_specific_settings": {
    "gecko": {
      "id": "custom.quicktext.scripts@altgr.xyz",
      "strict_min_version": "136.0"
    }
  },
  "background": {
    "type": "module",
    "scripts": [
      "assets/background.js"
    ]
  },
  "permissions": [
    "compose",
    "management",
    "storage",
    "messagesRead",
    "accountsRead"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "24": "assets/icon24.png",
    "32": "assets/icon.png"
  }
}
